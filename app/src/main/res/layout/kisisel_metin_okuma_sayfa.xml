<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    tools:ignore="all">

    <!-- Üst Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Geri Butonu (Yuvarlak Kapsül İçinde) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="@string/kategoriler"
            android:elevation="1dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <!-- Okuma Süresi Hapı -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#F1F5F9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_time"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/txtReadTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/su_kadar_dk_okuma"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ayarlar / Okuma Modu Butonu -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFFFF"
            android:clickable="true"
            android:contentDescription="@string/ayarlar"
            android:elevation="1dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_tune"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <!-- İçerik Katmanı -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Kategori Rozeti (Etiket) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#E0F2FE"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bookmark"
                        app:tint="#0284C7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZİHİNSEL MODELLER"
                        android:textColor="#0284C7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Başlık -->
                <TextView
                    android:id="@+id/baslik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/baslik_1"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Ana İçerik Metni -->
                <TextView
                    android:id="@+id/txtMainContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/gecici"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <!-- ASIL METİN İÇİN KOPYALA / PAYLAŞ BUTON SATIRI (Hap Tasarım) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCopyMainText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:backgroundTint="#F1F5F9"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/kopyala"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_copy"
                        app:drawableTint="#475569" />

                    <TextView
                        android:id="@+id/btnShareMainText"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:backgroundTint="#F1F5F9"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/paylas"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_share"
                        app:drawableTint="#475569" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="#E2E8F0" />

                <!-- Kişisel Not Başlığı ve Otomatik Kaydedildi Durumu -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_note_sticky"
                            app:tint="#D97706" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/kisisel_notum"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Canlı Otomatik Kayıt Durumu -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="● Otomatik kaydedildi"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- 1. Kişisel Not Kutusu -->
                <EditText
                    android:id="@+id/etPersonalNote"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="1dp"
                    android:gravity="top|start"
                    android:hint="@string/otomatik_kayit_not_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- 2. Not Kutusunun Altına Bağımsız Yerleştirilen Butonlar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Kişisel Notu Kopyala Butonu -->
                    <TextView
                        android:id="@+id/btnCopyNote"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:backgroundTint="#F1F5F9"
                        android:clickable="true"
                        android:drawablePadding="6dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/kopyala"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_copy"
                        app:drawableTint="#475569" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Kaydet Butonu -->
                    <LinearLayout
                        android:id="@+id/btnBookmarkSave"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_black_pill"
                        android:backgroundTint="#0F172A"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:id="@+id/imgBookmarkIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bookmark"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:id="@+id/txtBookmarkStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/kaydedilenler"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- MİKRO BİLGİLENDİRME / DİSCLAIMER KUTUSU -->
                <LinearLayout
                    android:id="@+id/disclaimerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="#F8FAFC"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/icDisclaimer"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_time"
                        app:tint="#D97706" />

                    <TextView
                        android:id="@+id/txtDisclaimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/uyari_uzman"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/cardSettingsPanel"
            layout="@layout/layout_okuma_ayarlari_paneli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </FrameLayout>

</RelativeLayout>