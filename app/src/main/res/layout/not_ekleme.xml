<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:backgroundTint="#FFFFFF"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ÜST BAŞLIK VE KAPATMA BUTONU -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hangi_kategori_olsun"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/notunuz_icin_baslik_ve_etiket_secin"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#F1F5F9"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="#64748B" />
    </RelativeLayout>

    <!-- NOT İSMİ / BAŞLIĞI GİRİŞ ALANI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/not_ismi_basligi"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNewNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_bar"
            android:backgroundTint="#F8FAFC"
            android:hint="@string/orn_fikir_notlar_istege_bagl"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- KATEGORİ 1: KİŞİSEL -->
    <RelativeLayout
        android:id="@+id/cardCategoryPersonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F8FAFC"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/imgArrow1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_purple"
                android:backgroundTint="#E0F2FE"
                android:padding="8dp"
                android:src="@drawable/ic_user"
                app:tint="#0284C7" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kisisel"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kisisel_dusunce_ve_gunluk_notlar"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgArrow1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- KATEGORİ 2: GEÇİCİ NOT (Hazır Süre Şablonları ile Birlikte) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F8FAFC"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:id="@+id/cardCategoryEphemeral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@id/imgArrow2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_icon_purple"
                    android:backgroundTint="#FEF3C7"
                    android:padding="8dp"
                    android:src="@drawable/ic_time"
                    app:tint="#D97706" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gecici_not"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/otomatik_silinecek_gecici_fikirler"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgArrow2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <!-- 3'LÜ HAZIR SÜRE ŞABLONLARI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDuration1h"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FEF3C7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1 Saat"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDuration3h"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FEF3C7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="3 Saat"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDuration24h"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FEF3C7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="24 Saat"
                android:textColor="#B45309"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- KATEGORİ 3: FİKİR & TASLAK (İş / Okul Yerine) -->
    <RelativeLayout
        android:id="@+id/cardCategoryWork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_search_bar"
        android:backgroundTint="#F8FAFC"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/imgArrow3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_purple"
                android:backgroundTint="#F5F3FF"
                android:padding="8dp"
                android:src="@drawable/ic_lightbulb"
                app:tint="#7C3AED" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fikir &amp; Taslak"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anlık ilhamlar, eskizler ve proje fikirleri"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imgArrow3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />
    </RelativeLayout>

    <!-- + YENİ KATEGORİ EKLE -->
    <TextView
        android:id="@+id/btnAddCustomCategory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dashed_border"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/yeni_kategori_ekle"
        android:textColor="#0284C7"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- İPTAL ET BUTONU -->
    <TextView
        android:id="@+id/btnCancelDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/ptal"
        android:textColor="#7C3AED"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>