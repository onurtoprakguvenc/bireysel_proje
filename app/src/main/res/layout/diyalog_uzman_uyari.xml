<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_search_bar"
    android:orientation="vertical"
    android:padding="24dp"
    tools:ignore="all">

    <!-- Başlık İkonu ve Metni -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lightbulb"
            app:tint="#EF4444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onemli_bilgilendirme"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Metin Gövdesi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/uyarı_giris_sayfa_pop_up"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Onay Butonu -->
    <TextView
        android:id="@+id/btnAcceptDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_black_icon_box"
        android:gravity="center"
        android:text="@string/anladım_ve_kabul_ediyorum"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>