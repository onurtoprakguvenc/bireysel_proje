<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    android:fitsSystemWindows="true"
    tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck,DuplicateSpeakableTextCheck,ImageContrastCheck,TextContrastCheck,VisualLintBounds,VisualLintOverlap,VisualLintTextFieldSize,VisualLintButtonSize">

    <!-- ================================================================= -->
    <!-- ÜST BAR (HEADER)                                                  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/app_name"
            app:tint="#1E293B" />

        <!-- Başlık ve Canlı Durum Rozeti -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="8dp">

            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/basliksiz_not"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#0F172A"
                android:background="@null"
                android:gravity="center"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:importantForAutofill="no" />

            <!-- Canlı Durum Rozeti (Örn: ● Kaydedildi 12:43) -->
            <TextView
                android:id="@+id/tvSaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/kaydedildi_12_43"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- GEÇİCİ NOT SÜRE AYARLAMA BUTONU -->
        <ImageButton
            android:id="@+id/btnEphemeralTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_recent_history"
            android:contentDescription="@string/app_name"
            app:tint="#64748B" />

        <ImageButton
            android:id="@+id/btnPinNote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pin"
            android:contentDescription="@string/app_name"
            app:tint="#64748B" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- TUVAL, CANLI METİN KATMANI VE YÜZEN KILAVUZ ÇUBUĞU (CANVAS)      -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/editorHeader"
        android:layout_above="@id/editorFooterToolbar">

        <com.example.hadi_bakalm.model.DrawingView
            android:id="@+id/globalDrawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/inlineTextEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:minWidth="60dp"
            android:minHeight="48dp"
            android:visibility="gone"
            android:imeOptions="actionDone"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"
            android:padding="2dp" />

        <!-- Sağ Üstteki Yüzen Kılavuz/Izgara Kapsülü (Floating Toolbar) -->
        <LinearLayout
            android:id="@+id/floatingGridTools"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnGridOptions"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="@string/app_name"
                app:tint="#64748B" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#E2E8F0"
                android:layout_marginHorizontal="6dp" />

            <ImageButton
                android:id="@+id/btnGridToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_table"
                android:contentDescription="@string/app_name"
                app:tint="#64748B" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#E2E8F0"
                android:layout_marginHorizontal="6dp" />

            <ImageButton
                android:id="@+id/btnCanvasClearQuick"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_hand"
                android:contentDescription="@string/app_name"
                app:tint="#64748B" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================================================================= -->
    <!-- ALT ARAÇ ÇUBUĞU (MODERN TEK SIRALI FOOTER TOOLBAR)                 -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorFooterToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:elevation="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawingToolBar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. Kapsül: Geri Al / İleri Al -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9">

                    <ImageButton
                        android:id="@+id/btnToolUndo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_left"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#475569" />

                    <ImageButton
                        android:id="@+id/btnToolRedo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_chevron_left"
                        android:rotation="180"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#475569" />
                </LinearLayout>

                <!-- 2. Kapsül: Çizim Araçları (Kalem, Fosforlu, Metin, Silgi, İmleç) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9">

                    <FrameLayout
                        android:id="@+id/frameToolPen"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:backgroundTint="#E2E8F0">

                        <ImageButton
                            android:id="@+id/btnToolPen"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_pen"
                            android:contentDescription="@string/app_name"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#0F172A" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frameToolHighlighter"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="@android:color/transparent">

                        <ImageButton
                            android:id="@+id/btnToolHighlighter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_highlighter"
                            android:contentDescription="@string/app_name"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:tint="#64748B" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frameToolText"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:background="@android:color/transparent">

                        <TextView
                            android:id="@+id/btnToolText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/t"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="#64748B"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_eraser"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnToolSelect"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_cursor"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnToolLasso"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_lasso"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnToolShapes"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_table"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnToolScroll"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_hand"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#64748B" />
                </LinearLayout>

                <!-- 3. Kapsül: Renk Paleti -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/colorBlack"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/shape_color_circle_black"
                        android:contentDescription="@string/app_name"
                        android:layout_marginEnd="6dp" />

                    <ImageView
                        android:id="@+id/colorBlue"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/shape_color_circle_blue"
                        android:contentDescription="@string/app_name"
                        android:layout_marginEnd="6dp" />

                    <ImageView
                        android:id="@+id/colorRed"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#EF4444"
                        android:contentDescription="@string/app_name"
                        android:layout_marginEnd="6dp" />

                    <ImageView
                        android:id="@+id/colorGreen"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#10B981"
                        android:contentDescription="@string/app_name"
                        android:layout_marginEnd="6dp" />

                    <ImageButton
                        android:id="@+id/btnColorPicker"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/shape_color_circle_blue"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <ImageButton
                        android:id="@+id/btnClearCanvas"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_trash"
                        android:contentDescription="@string/app_name"
                        app:tint="#EF4444"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. Kapsül: Tablo & Görsel Ekleme Butonları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAddTable"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tablo_ekle"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_table"
                app:iconTint="#0284C7"
                app:iconSize="16dp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnAddImage"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/gorsel_ekle"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="6dp"
                app:icon="@drawable/ic_image"
                app:iconTint="#0284C7"
                app:iconSize="16dp"
                app:cornerRadius="10dp" />

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>