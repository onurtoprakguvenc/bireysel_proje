<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Üst Bar (Header) -->
    <LinearLayout
        android:id="@+id/editorHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="@string/app_name"
            app:tint="#475569" />

        <EditText
            android:id="@+id/etNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/basliksiz_not"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0F172A"
            android:background="@null"
            android:gravity="center"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnPinNote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pin"
            android:contentDescription="@string/app_name"
            app:tint="#94A3B8" />
    </LinearLayout>

    <!-- TEK VE ÖZGÜR KATMAN: Tüm Ekranı Kaplayan Tuval -->
    <com.example.hadi_bakalm.model.DrawingView
        android:id="@+id/globalDrawingCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/editorHeader"
        android:layout_above="@id/editorFooterToolbar" />

    <!-- Alt Araç Çubuğu (Toolbar) -->
    <LinearLayout
        android:id="@+id/editorFooterToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:elevation="12dp">

        <LinearLayout
            android:id="@+id/drawingToolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 1. Katman: Geri Al, İleri Al, Silgi, Şekiller, El İkonu (Kaydırma) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnToolUndo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="@string/app_name"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#475569" />

                <ImageButton
                    android:id="@+id/btnToolRedo"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_chevron_left"
                    android:rotation="180"
                    android:contentDescription="@string/app_name"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#475569" />

                <ImageButton
                    android:id="@+id/btnToolEraser"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_eraser"
                    android:contentDescription="@string/app_name"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#475569" />

                <ImageButton
                    android:id="@+id/btnToolShapes"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_table"
                    android:contentDescription="@string/app_name"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#475569" />

                <ImageButton
                    android:id="@+id/btnToolScroll"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_hand"
                    android:contentDescription="@string/app_name"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#475569" />
            </LinearLayout>

            <!-- 2. Katman: Kalem Çizim Modu, Fosforlu Kalem, Renkler ve Temizleme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="8dp">

                <FrameLayout
                    android:id="@+id/frameToolPen"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_inactive">

                    <ImageButton
                        android:id="@+id/btnToolPen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_pen"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#475569" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/frameToolHighlighter"
                    android:layout_width="44dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive">

                    <ImageButton
                        android:id="@+id/btnToolHighlighter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_highlighter"
                        android:contentDescription="@string/app_name"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#475569" />
                </FrameLayout>

                <!-- Renk Paleti (Yatay Kaydırılabilir) -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none"
                    android:layout_marginHorizontal="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/colorBlack"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/shape_color_circle_black"
                            android:contentDescription="@string/app_name"
                            android:layout_marginEnd="10dp" />

                        <ImageView
                            android:id="@+id/colorBlue"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/shape_color_circle_blue"
                            android:contentDescription="@string/app_name"
                            android:layout_marginEnd="10dp" />

                        <ImageView
                            android:id="@+id/colorRed"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/shape_color_circle_black"
                            app:tint="#EF4444"
                            android:contentDescription="@string/app_name"
                            android:layout_marginEnd="10dp" />

                        <ImageView
                            android:id="@+id/colorGreen"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/shape_color_circle_black"
                            app:tint="#10B981"
                            android:contentDescription="@string/app_name"
                            android:layout_marginEnd="10dp" />

                        <ImageButton
                            android:id="@+id/btnColorPicker"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/shape_color_circle_blue"
                            android:contentDescription="@string/app_name"
                            android:background="?attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btnClearCanvas"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="@string/app_name"
                    app:tint="#EF4444"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </LinearLayout>

        <!-- 3. Katman: Medya Ekleme Araçları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAddTable"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/tablo"
                android:textSize="11sp"
                android:textColor="#334155"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_table"
                app:iconTint="#334155"
                app:iconSize="14dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnAddImage"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/gorsel"
                android:textSize="11sp"
                android:textColor="#334155"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp"
                app:icon="@drawable/ic_image"
                app:iconTint="#334155"
                app:iconSize="14dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnRecordVoice"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/ses_kaydi"
                android:textSize="11sp"
                android:textColor="#334155"
                android:backgroundTint="#F1F5F9"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_mic"
                app:iconTint="#334155"
                app:iconSize="14dp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>