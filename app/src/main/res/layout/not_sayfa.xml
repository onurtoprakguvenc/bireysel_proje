<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    android:fitsSystemWindows="true"
    tools:ignore="all">

    <!-- ================================================================= -->
    <!-- ÜST BAR (HEADER)                                                  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_chevron_left"
            app:tint="#1E293B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:hint="@string/basliksiz_not"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Canlı Kalan Süre Rozeti -->
        <LinearLayout
            android:id="@+id/containerEphemeralBadge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FEE2E2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#DC2626" />

            <TextView
                android:id="@+id/tvEphemeralBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="2 dk kaldı"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEphemeralTimer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@android:drawable/ic_menu_recent_history"
            app:tint="#64748B" />

        <ImageButton
            android:id="@+id/btnPinNote"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pin"
            app:tint="#64748B" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- ÇALIŞMA ALANI (CANVAS & METİN KATMANI)                           -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/editorFooterToolbar"
        android:layout_below="@id/editorHeader">

        <com.example.hadi_bakalm.model.DrawingView
            android:id="@+id/globalDrawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/inlineTextEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minWidth="60dp"
            android:minHeight="48dp"
            android:padding="2dp"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Sağ Üst Sayfa Çizgi Modları Kapsayıcısı -->
        <LinearLayout
            android:id="@+id/containerPageGridModes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <!-- 0. Düz / Çizgisiz Sayfa Modu -->
            <ImageButton
                android:id="@+id/btnBlankPageToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Düz Sayfa"
                android:padding="6dp"
                android:src="@drawable/ic_blank_page"
                app:tint="#0284C7" />

            <!-- 1. Kareli Izgara Modu -->
            <ImageButton
                android:id="@+id/btnGridToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kareli Mod"
                android:padding="6dp"
                android:src="@drawable/ic_table"
                app:tint="#64748B" />

            <!-- 2. Yatay Çizgili Defter Modu -->
            <ImageButton
                android:id="@+id/btnHorizontalLinesToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Yatay Çizgili Mod"
                android:padding="6dp"
                android:src="@drawable/ic_list"
                app:tint="#64748B" />

            <!-- 3. Dikey Çizgili Sütun Modu -->
            <ImageButton
                android:id="@+id/btnVerticalLinesToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Dikey Çizgili Mod"
                android:padding="6dp"
                android:rotation="90"
                android:src="@drawable/ic_list"
                app:tint="#64748B" />
        </LinearLayout>

        <!-- Manuel Zoom In (+) ve Zoom Out (-) Kapsayıcısı -->
        <LinearLayout
            android:id="@+id/containerZoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <!-- Zoom In (+) -->
            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Yakınlaştır"
                android:padding="6dp"
                android:src="@drawable/ic_zoom_in"
                app:tint="#64748B" />

            <!-- Ara Ayırıcı Çizgi -->
            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:layout_marginVertical="2dp"
                android:background="#E2E8F0" />

            <!-- Zoom Out (-) -->
            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Uzaklaştır"
                android:padding="6dp"
                android:src="@drawable/ic_zoom_out"
                app:tint="#64748B" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================================================================= -->
    <!-- ALT ARAÇ ÇUBUĞU                                                   -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorFooterToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/drawingToolBar"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Geri Al / İleri Al -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <ImageButton
                        android:id="@+id/btnToolUndo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#475569" />

                    <ImageButton
                        android:id="@+id/btnToolRedo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:rotation="180"
                        android:src="@drawable/ic_chevron_left"
                        app:tint="#475569" />
                </LinearLayout>

                <!-- Çizim, El (Kaydırma) ve Seçim Araçları -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <!-- EL / KAYDIRMA ARACI -->
                    <ImageButton
                        android:id="@+id/btnToolHand"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Kaydırma Modu"
                        android:padding="5dp"
                        android:src="@drawable/ic_hand"
                        app:tint="#64748B" />

                    <!-- Kalem -->
                    <FrameLayout
                        android:id="@+id/frameToolPen"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_chip_inactive"
                        android:backgroundTint="#E2E8F0">

                        <ImageButton
                            android:id="@+id/btnToolPen"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_pen"
                            app:tint="#0F172A" />
                    </FrameLayout>

                    <!-- Fosforlu Kalem -->
                    <FrameLayout
                        android:id="@+id/frameToolHighlighter"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="@android:color/transparent">

                        <ImageButton
                            android:id="@+id/btnToolHighlighter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_highlighter"
                            app:tint="#64748B" />
                    </FrameLayout>

                    <!-- Metin Aracı -->
                    <FrameLayout
                        android:id="@+id/frameToolText"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="@android:color/transparent">

                        <TextView
                            android:id="@+id/btnToolText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/t"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Silgi -->
                    <ImageButton
                        android:id="@+id/btnToolEraser"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_eraser"
                        app:tint="#64748B" />

                    <!-- Seçim İmleci -->
                    <ImageButton
                        android:id="@+id/btnToolSelect"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_cursor"
                        app:tint="#64748B" />

                    <!-- Kement -->
                    <ImageButton
                        android:id="@+id/btnToolLasso"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_lasso"
                        app:tint="#64748B" />

                    <!-- Şekiller -->
                    <ImageButton
                        android:id="@+id/btnToolShapes"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_shapes"
                        app:tint="#64748B" />
                </LinearLayout>

                <!-- Ekleme Araçları -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnAddTable"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_table"
                        app:tint="#0284C7" />

                    <ImageButton
                        android:id="@+id/btnAddImage"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_image"
                        app:tint="#0284C7" />
                </LinearLayout>

                <!-- Renk Paleti -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/colorBlack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/shape_color_circle_black" />

                    <ImageView
                        android:id="@+id/colorBlue"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/shape_color_circle_blue" />

                    <ImageView
                        android:id="@+id/colorRed"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#EF4444" />

                    <ImageView
                        android:id="@+id/colorGreen"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#10B981" />

                    <ImageButton
                        android:id="@+id/btnColorPicker"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/shape_color_circle_blue" />
                </LinearLayout>

                <!-- Tuvali Temizle -->
                <ImageButton
                    android:id="@+id/btnClearCanvas"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_trash"
                    app:tint="#EF4444" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</RelativeLayout>