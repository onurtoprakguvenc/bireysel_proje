<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    android:fitsSystemWindows="true"
    tools:ignore="all">

    <!-- ================================================================= -->
    <!-- ÜST BAR (HEADER - SADELEŞTİRİLMİŞ DÜZEN)                          -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_chevron_left"
            app:tint="#1E293B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/basliksiz_not"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Canlı Kalan Süre Rozeti (Sadece Süre Varsa Görünür) -->
        <LinearLayout
            android:id="@+id/containerEphemeralBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FEE2E2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#DC2626" />

            <TextView
                android:id="@+id/tvEphemeralBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="2 dk kaldı"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tuval Kilitle / Salt Okunur Butonu -->
        <ImageButton
            android:id="@+id/btnLockCanvas"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sayfayı Kilitle"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="#64748B" />

        <!-- Sabitle Butonu -->
        <ImageButton
            android:id="@+id/btnPinNote"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pin"
            app:tint="#64748B" />

        <!-- Paylaş Butonu -->
        <ImageButton
            android:id="@+id/btnShareNote"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_share"
            app:tint="#64748B" />

        <!-- Daha Fazla / Ekstra Seçenekler (3 Nokta) -->
        <ImageButton
            android:id="@+id/btnMoreOptions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Diğer Seçenekler"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#64748B" />

        <!-- Kaydet / Bitti Butonu -->
        <ImageButton
            android:id="@+id/btnSaveNote"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kaydet"
            android:src="@drawable/ic_check"
            app:tint="#0284C7" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- ÇALIŞMA ALANI (CANVAS & METİN KATMANI)                           -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/editorFooterToolbar"
        android:layout_below="@id/editorHeader">

        <com.example.hadi_bakalm.model.DrawingView
            android:id="@+id/globalDrawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <EditText
            android:id="@+id/inlineTextEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minWidth="60dp"
            android:minHeight="48dp"
            android:padding="2dp"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:visibility="gone" />

        <!-- Sağ Üst: Katlanabilir Panel Kapsayıcısı -->
        <LinearLayout
            android:id="@+id/containerCollapsibleRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="top|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnToggleRightPanel"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FFFFFF"
                android:elevation="3dp"
                android:contentDescription="Paneli Gizle/Aç"
                android:padding="4dp"
                android:src="@drawable/ic_chevron_left"
                android:rotation="180"
                app:tint="#64748B" />

            <LinearLayout
                android:id="@+id/layoutRightSidePanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/containerPageGridModes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageButton
                        android:id="@+id/btnBlankPageToggle"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Düz Sayfa"
                        android:padding="5dp"
                        android:src="@drawable/ic_blank_page"
                        app:tint="#0284C7" />

                    <ImageButton
                        android:id="@+id/btnGridToggle"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Kareli Mod"
                        android:padding="5dp"
                        android:src="@drawable/ic_table"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnHorizontalLinesToggle"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Yatay Çizgili Mod"
                        android:padding="5dp"
                        android:src="@drawable/ic_list"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnVerticalLinesToggle"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dikey Çizgili Mod"
                        android:padding="5dp"
                        android:rotation="90"
                        android:src="@drawable/ic_list"
                        app:tint="#64748B" />
                </LinearLayout>

                <!-- Sağ Panel: Kağıt Temaları (Sağa Hizalı) -->
                <LinearLayout
                    android:id="@+id/containerCanvasThemes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/themeWhiteToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_circle_brand"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#FFFFFF" />

                    <ImageView
                        android:id="@+id/themeSepiaToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#FDF6E2" />

                    <ImageView
                        android:id="@+id/themeDarkToggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/shape_color_circle_black"
                        app:tint="#1E293B" />
                </LinearLayout>

                <!-- Zoom Kontrolleri -->
                <LinearLayout
                    android:id="@+id/containerZoomControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#FFFFFF"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <ImageButton
                        android:id="@+id/btnZoomIn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Yakınlaştır"
                        android:padding="5dp"
                        android:src="@drawable/ic_zoom_in"
                        app:tint="#64748B" />

                    <ImageButton
                        android:id="@+id/btnResetZoom"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Görünümü Sıfırla"
                        android:padding="6dp"
                        android:src="@drawable/ic_expand_arrow"
                        app:tint="#0284C7" />

                    <ImageButton
                        android:id="@+id/btnZoomOut"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Uzaklaştır"
                        android:padding="5dp"
                        android:src="@drawable/ic_zoom_out"
                        app:tint="#64748B" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ================================================================= -->
    <!-- ALT ARAÇ ÇUBUĞU                                                   -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/editorFooterToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <!-- 1. SATIR: TEMEL ÇİZİM ARAÇLARI (SADE MOD) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Geri / İleri Al -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageButton
                    android:id="@+id/btnToolUndo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#475569" />

                <ImageButton
                    android:id="@+id/btnToolRedo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/app_name"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#475569" />
            </LinearLayout>

            <!-- Temel Araçlar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <ImageButton
                    android:id="@+id/btnToolHand"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kaydırma"
                    android:padding="5dp"
                    android:src="@drawable/ic_hand"
                    app:tint="#64748B" />

                <FrameLayout
                    android:id="@+id/frameToolPen"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#E2E8F0">

                    <ImageButton
                        android:id="@+id/btnToolPen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Kalem"
                        android:src="@drawable/ic_pen"
                        app:tint="#0F172A" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/frameToolHighlighter"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="@android:color/transparent">

                    <ImageButton
                        android:id="@+id/btnToolHighlighter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Fosforlu"
                        android:src="@drawable/ic_highlighter"
                        app:tint="#64748B" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/frameToolText"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="@android:color/transparent">

                    <TextView
                        android:id="@+id/btnToolText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/t"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btnToolEraser"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Silgi"
                    android:src="@drawable/ic_eraser"
                    app:tint="#64748B" />
            </LinearLayout>

            <!-- 1. Satırdaki 3'lü Renk Paleti -->
            <LinearLayout
                android:id="@+id/containerBasicColors"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/colorBlackBasic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Siyah"
                    android:src="@drawable/shape_color_circle_black" />

                <ImageView
                    android:id="@+id/colorBlueBasic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Mavi"
                    android:src="@drawable/shape_color_circle_blue" />

                <ImageView
                    android:id="@+id/colorRedBasic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Kırmızı"
                    android:src="@drawable/shape_color_circle_black"
                    app:tint="#EF4444" />
            </LinearLayout>

            <!-- Gelişmiş Mod Açma / Kapatma Butonu -->
            <ImageButton
                android:id="@+id/btnToggleEditorMode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:contentDescription="Gelişmiş Mod"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                app:tint="#0284C7" />

            <!-- Çöp Kutusu -->
            <ImageButton
                android:id="@+id/btnClearCanvas"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Temizle"
                android:src="@drawable/ic_trash"
                app:tint="#EF4444" />
        </LinearLayout>

        <!-- 2. SATIR: GELİŞMİŞ ARAÇLAR (ADVANCED ROW) -->
        <LinearLayout
            android:id="@+id/layoutAdvancedToolsRow"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- 1. Grup: Seçim ve Geometri -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <ImageButton
                    android:id="@+id/btnToolSelect"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seçim"
                    android:src="@drawable/ic_cursor"
                    app:tint="#64748B" />

                <ImageButton
                    android:id="@+id/btnToolLasso"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Kement"
                    android:src="@drawable/ic_lasso"
                    app:tint="#64748B" />

                <ImageButton
                    android:id="@+id/btnToolShapes"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Şekiller"
                    android:src="@drawable/ic_shapes"
                    app:tint="#64748B" />
            </LinearLayout>

            <!-- 2. Grup: Tablo & Görsel Ekleme -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <ImageButton
                    android:id="@+id/btnAddTable"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tablo"
                    android:src="@drawable/ic_table"
                    app:tint="#0284C7" />

                <ImageButton
                    android:id="@+id/btnAddImage"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Görsel"
                    android:src="@drawable/ic_image"
                    app:tint="#0284C7" />
            </LinearLayout>

            <!-- 3. Grup: METİN BİÇİMLENDİRME (ONENOTE STİLİ A & FOSFORLU METİN VURGUSU) -->
            <LinearLayout
                android:id="@+id/groupTextFormatTools"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <!-- A: Metin Yazı Rengi Butonu (Altında renk şeridi ile) -->
                <FrameLayout
                    android:id="@+id/frameTextColor"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@android:color/transparent">

                    <TextView
                        android:id="@+id/btnTextColor"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/indicatorTextColor"
                        android:layout_width="14dp"
                        android:layout_height="2.5dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="2dp"
                        android:background="#EF4444" />
                </FrameLayout>

                <!-- Fosforlu Vurgu Butonu (Altında sarı şerit ile) -->
                <FrameLayout
                    android:id="@+id/frameTextHighlight"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="3dp"
                    android:background="@android:color/transparent">

                    <ImageButton
                        android:id="@+id/btnTextHighlight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Metin Vurgusu"
                        android:padding="5dp"
                        android:src="@drawable/ic_highlighter"
                        app:tint="#475569" />

                    <View
                        android:id="@+id/indicatorTextHighlight"
                        android:layout_width="14dp"
                        android:layout_height="2.5dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="2dp"
                        android:background="#FACC15" />
                </FrameLayout>
            </LinearLayout>

            <!-- 4. Grup: 5'li Tam Renk Paleti -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:id="@+id/colorBlack"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Siyah"
                    android:src="@drawable/shape_color_circle_black" />

                <ImageView
                    android:id="@+id/colorBlue"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="Mavi"
                    android:src="@drawable/shape_color_circle_blue" />

                <ImageView
                    android:id="@+id/colorRed"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="Kırmızı"
                    android:src="@drawable/shape_color_circle_black"
                    app:tint="#EF4444" />

                <ImageView
                    android:id="@+id/colorGreen"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:contentDescription="Yeşil"
                    android:src="@drawable/shape_color_circle_black"
                    app:tint="#10B981" />

                <ImageButton
                    android:id="@+id/btnColorPicker"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Özel Renk"
                    android:src="@drawable/shape_color_circle_blue" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>