<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Silgi Boyutu"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEraserSizePreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Boyut: 24 px"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- HASSAS AYAR ÇUBUĞU (SEEKBAR) -->
    <SeekBar
        android:id="@+id/seekBarEraserWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="80"
        android:progress="24"
        android:progressTint="#0284C7"
        android:thumbTint="#0284C7" />

    <!-- HIZLI SEÇİM BUTONLARI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnEraserThin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Küçük"
            android:textColor="#0F172A"
            android:textSize="12sp"
            app:strokeColor="#CBD5E1" />

        <Button
            android:id="@+id/btnEraserMedium"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Orta"
            android:textColor="#0F172A"
            android:textSize="12sp"
            app:strokeColor="#CBD5E1" />

        <Button
            android:id="@+id/btnEraserThick"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Büyük"
            android:textColor="#0F172A"
            android:textSize="12sp"
            app:strokeColor="#CBD5E1" />
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseEraserDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#0284C7"
        android:text="Tamam"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>