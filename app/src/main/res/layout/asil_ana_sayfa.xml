<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    tools:context=".model.MainActivity">

    <!-- Üst Bar & Arama Alanı Kapsayıcısı -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="#FFFFFF"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Başlık, Kasa Kapatma Butonu ve Üst Butonlar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- 1. Sol Başlık ve Gizli Kasa Çıkış Butonu Grubu -->
            <LinearLayout
                android:id="@+id/containerTitleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/headerActions"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/notlarim"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- KASAYI KİLİTLE VE ÇIK BUTONU (Sadece Kasa Açıkken Görünür) -->
                <ImageButton
                    android:id="@+id/btnCloseVault"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#FEE2E2"
                    android:contentDescription="Kasayı Kilitle ve Çık"
                    android:padding="6dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#DC2626"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- 2. Sağ Buton Grubu -->
            <LinearLayout
                android:id="@+id/headerActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Bağış Yap -->
                <ImageButton
                    android:id="@+id/fabDonateCoffee"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/bagis_yap"
                    android:padding="13dp"
                    android:src="@drawable/ic_coffe_support"
                    app:tint="#64748B" />

                <!-- Zihinsel Kütüphane -->
                <ImageButton
                    android:id="@+id/btnLibraryBridge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/kutuphane_koprusu"
                    android:padding="13dp"
                    android:src="@drawable/ic_brain"
                    app:tint="#64748B" />

                <!-- Grid / List Görünümü -->
                <ImageButton
                    android:id="@+id/btnToggleLayout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/duzeni_degistir"
                    android:padding="13dp"
                    android:src="@drawable/ic_grid"
                    app:tint="#64748B" />

                <!-- Ayarlar Dişli Butonu -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/ayarlar"
                    android:padding="13dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#64748B" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Arama Çubuğu -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="#F1F5F9"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="#475569"
                android:hint="@string/notlarda_veya_etiketlerde_ara"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#475569"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="488dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Kategori Çipleri -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryChipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_active"
                    android:backgroundTint="#0F172A"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/tumu"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="@string/kisisel"
                    android:textColor="#334155"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Çizim"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Geçici"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="İş"
                    android:textColor="#334155"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Notlar Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_note_card"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Boş Ekran Durumu (Empty State) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgEmptyState"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_document"
            app:tint="#CBD5E1"
            android:contentDescription="Boş Durum İkonu" />

        <TextView
            android:id="@+id/tvEmptyStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Henüz not bulunmuyor"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyStateSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Yeni bir not veya çizim eklemek için + butonuna dokunun."
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>



    <!-- Hızlı Not FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabQuickNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/ic_pen"
        app:tint="#0284C7"
        app:backgroundTint="#E0F2FE"
        app:fabCustomSize="46dp"
        app:maxImageSize="20dp"
        app:elevation="4dp"
        android:contentDescription="Hızlı Not Al"
        app:layout_constraintEnd_toStartOf="@id/fabAddNote"
        app:layout_constraintTop_toTopOf="@id/fabAddNote"
        app:layout_constraintBottom_toBottomOf="@id/fabAddNote"
        tools:ignore="DefaultCustomViewAccessibility,HardcodedText" />

    <!-- Standart Yeni Not Ekleme FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/ic_plus"
        app:tint="#FFFFFF"
        app:backgroundTint="#0284C7"
        app:fabCustomSize="56dp"
        app:maxImageSize="24dp"
        app:elevation="6dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/yeni_not_ekle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="DefaultCustomViewAccessibility"/>

</androidx.constraintlayout.widget.ConstraintLayout>