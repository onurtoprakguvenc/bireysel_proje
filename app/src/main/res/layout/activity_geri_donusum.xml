<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    tools:ignore="all">

    <!-- ================================================================= -->
    <!-- ÜST BAR (HEADER CONTAINER)                                        -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/trashHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Geri Butonu & Başlık -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackFromTrash"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/app_name"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#1E293B" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geri Dönüşüm"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrashInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Notlar 7 gün sonra otomatik silinir"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Çöpü Boşalt Butonu (Kırmızı Kapsül) -->
            <TextView
                android:id="@+id/btnEmptyTrash"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FEE2E2"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Tümünü Sil"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Arama Çubuğu -->
        <EditText
            android:id="@+id/etSearchTrash"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_search_input"
            android:backgroundTint="#F1F5F9"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="#94A3B8"
            android:hint="Çöp kutusunda ara..."
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#1E293B"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- SİLİNEN NOTLAR LİSTESİ                                            -->
    <!-- ================================================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrashNotes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/trashHeaderContainer"
        tools:listitem="@layout/item_trash_note_card" />

    <!-- Boş Durum (Empty State) -->
    <LinearLayout
        android:id="@+id/layoutEmptyTrash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/trashHeaderContainer">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#F1F5F9"
            android:padding="16dp"
            android:src="@drawable/ic_trash"
            app:tint="#94A3B8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Geri dönüşüm kutusu boş"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>