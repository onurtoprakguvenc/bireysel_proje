<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <!-- Status bar yüksekliği kadar boşluk bırakan spacer -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ================================================================= -->
    <!-- ÜST BAR (HEADER CONTAINER)                                        -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/trashHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpacer">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- Çöpü Boşalt Butonu (Kırmızı Kapsül) — önce tanımlanmalı ki soldaki ona göre hizalansın -->
            <TextView
                android:id="@+id/btnEmptyTrash"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#FEE2E2"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/tumunu_sil"
                android:textColor="#B91C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Geri Butonu & Başlık -->
            <LinearLayout
                android:id="@+id/backTitleGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnEmptyTrash"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBackFromTrash"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#F1F5F9"
                    android:contentDescription="@string/geri_don"
                    android:padding="12dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#1E293B" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/geri_donusum"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrashInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/notlar_7_gun_sonra_otomatik_silinir"
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Arama Çubuğu: ConstraintLayout ile genişlik sınırlı -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etSearchTrash"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="#F1F5F9"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="#475569"
                android:hint="@string/cop_kutusunda_ara"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="#1E293B"
                android:textColorHint="#475569"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="440dp"
                app:layout_constraintWidth_percent="0.92" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- SİLİNEN NOTLAR LİSTESİ                                            -->
    <!-- ================================================================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrashNotes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/trashHeaderContainer"
        tools:listitem="@layout/item_trash_note_card" />

    <!-- Boş Durum (Empty State) -->
    <TextView
        android:id="@+id/layoutEmptyTrash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:drawableTopCompat="@drawable/ic_trash"
        app:drawableTint="#64748B"
        android:drawablePadding="12dp"
        android:gravity="center"
        android:text="@string/geri_donusum_kutusu_bos"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/trashHeaderContainer"
        app:layout_constraintVertical_bias="0.35" />

</androidx.constraintlayout.widget.ConstraintLayout>