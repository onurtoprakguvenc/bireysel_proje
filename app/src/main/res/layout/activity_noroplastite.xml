<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_main">

    <!-- Üst Bar (Geri Ok ve Üç Nokta) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_primary" />
    </RelativeLayout>

    <!-- Kaydırılabilir İçerik Alanı -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Kavram Ana Başlığı -->
            <TextView
                android:id="@+id/txtConceptTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/kavram_temsili"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- 1. KART: Kavram Açıklaması -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtConceptDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/kavram_aciklamasi_normal"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnShare1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_share"
                            android:drawablePadding="8dp"
                            android:text="@string/paylas"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableTint="@color/text_secondary" />

                        <View
                            android:layout_width="32dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnCopy1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_copy"
                            android:drawablePadding="8dp"
                            android:text="@string/kopyala"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableTint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. KART: Kişisel Not -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtPersonalNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/kisisel_not_analiz"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/divider_color" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnShare2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_share"
                            android:drawablePadding="8dp"
                            android:text="@string/paylas"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableTint="@color/text_secondary" />

                        <View
                            android:layout_width="32dp"
                            android:layout_height="0dp" />

                        <TextView
                            android:id="@+id/btnCopy2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_copy"
                            android:drawablePadding="8dp"
                            android:text="@string/kopyala"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            app:drawableTint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Soru / Detaylandırma Başlığı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/nasil_detaylandirmak_istersin_aciklamayi"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Siyah Açılır Buton 1: Örnek Diyaloglar -->
            <FrameLayout
                android:id="@+id/btnDialogues"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_settings_card"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/ornek_diyalog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:text="@string/ornek_diyaloglar"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|end"
                    android:src="@drawable/ic_expand_arrow"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- AÇILACAK İÇERİK 1 -->
            <LinearLayout
                android:id="@+id/contentDialogues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtDialoguesContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buraya_ornek_diyaloglar_gelecek"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnShareDialogues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_share"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/paylas"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableTint="@color/text_secondary" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/btnCopyDialogues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_copy"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/kopyala"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableTint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Siyah Açılır Buton 2: Pratik Hayattaki Önemi -->
            <FrameLayout
                android:id="@+id/btnImportance"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_settings_card"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/bu_kavram_onem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:text="@string/pratik_hayattaki_onemi"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|end"
                    android:src="@drawable/ic_expand_arrow"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <!-- AÇILACAK İÇERİK 2 -->
            <LinearLayout
                android:id="@+id/contentImportance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtImportanceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buraya_pratik_hayattaki_onemi_ile_ilgili_metinler_gelecek"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnShareImportance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_share"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/paylas"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableTint="@color/text_secondary" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="0dp" />

                    <TextView
                        android:id="@+id/btnCopyImportance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_copy"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="8dp"
                        android:text="@string/kopyala"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:drawableTint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Alt Başlık ve Kaydet Butonu Satırı -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/btnSave"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_kaydet_button"
                    android:gravity="center"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_bookmark"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/kaydet_butonu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/kaydet_butonu"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>