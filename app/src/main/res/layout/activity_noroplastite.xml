<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">
        <!--  KAVRAM İSMİ  -->
        <TextView
            android:id="@+id/tvKavramIsmi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/noroplastite"
            android:textColor="#000000"
            android:textSize="34sp"
            android:textStyle="normal"
            />
        <!--  KAVRAM AÇIKLAMASI NORMAL  -->
        <TextView
            android:id="@+id/tvKavramAciklama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/kavram_acklamasi_normal"
            android:textColor="#000000"
            android:textSize="22sp"
            tools:text="kavram açıklaması normal"/>
        <!--  kavram açıklaması: paylaş / kopyala butonları  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btnPaylasAciklama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/paylas"
                    android:src="@drawable/ic_share"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/paylas"
                    android:textColor="#000000"
                    android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnKopyalaAciklama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/kopyala"
                    android:src="@drawable/ic_copy"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/kopyala"
                    android:textColor="#000000"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--  BENİM KİŞİSEL GELİŞTİRİCİ NOTUM  -->
        <TextView
            android:id="@+id/tvKisiselNot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/benim_ki_isel_geli_tirici_notum_ve_d_ncem_o_kavram_hakk_nda_e_er_varsa"
            android:textColor="#000000"
            android:textSize="22sp"
            tools:text="benim kişisel geliştirici notum ve düşüncem o kavram hakkında (eğer varsa)"/>
        <!--  kişisel not: paylaş / kopyala butonları  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/btnPaylasNot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/paylas"
                    android:src="@drawable/ic_share"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/paylas"
                    android:textColor="#000000"
                    android:textSize="13sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btnKopyalaNot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/paylas"
                    android:src="@drawable/ic_copy"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/kopyala"
                    android:textColor="#000000"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
        <!--  NASIL DETAYLANDIRMAK İSTERSİN  -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/nasil_detaylandirmak_istersin_aciklamayi"
            android:textColor="#000000"
            android:textSize="22sp"/>
        <!--  ==================== EXPANDABLE KART 1: ÖRNEK DİYALOGLAR ====================  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#000000"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/cardOrnekDiyaloglar"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ornek_diyaloglar"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>
                <ImageView
                    android:id="@+id/ivOkOrnekDiyaloglar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/genislet"
                    android:src="@drawable/ic_expand_arrow"/>
            </LinearLayout>
            <!--  Genişleyince açılacak içerik alanı; kod tarafında visibility=GONE/VISIBLE yapılacak  -->
            <TextView
                android:id="@+id/contentOrnekDiyaloglar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/buraya_prnek_diyalog_icerigi_gelecek"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"/>
        </LinearLayout>
        <!--  ==================== EXPANDABLE KART 2: PRATİK HAYATTAKİ ÖNEMİ ====================  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#000000"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/cardPratikOnemi"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pratik_hayattaki_onemi"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>
                <ImageView
                    android:id="@+id/ivOkPratikOnemi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/genislet"
                    android:src="@drawable/ic_expand_arrow"/>
            </LinearLayout>
            <TextView
                android:id="@+id/contentPratikOnemi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/buraya_pratik_hayattaki_onemi_gelecek"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"/>
        </LinearLayout>
        <!--  ==================== EXPANDABLE KART 3: VÜCUT İÇİNDE YARATTIĞI ETKİ ====================  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#000000"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/cardVucutEtkisi"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/vucut_icinde_yarattigi_etki"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"/>
                <ImageView
                    android:id="@+id/ivOkVucutEtkisi"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/genislet"
                    android:src="@drawable/ic_expand_arrow"/>
            </LinearLayout>
            <TextView
                android:id="@+id/contentVucutEtkisi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/buraya_v_cut_i_inde_yaratt_etki_i_eri_i_gelecek"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"/>
        </LinearLayout>
        <!--  BAĞLANTILI OLDUĞU DİĞER KAVRAMLAR + KAYDET BUTONU  -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <TextView
                android:id="@+id/tvBaglantiliKavramlarBaslik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/baglantili_oldugu_diger_kavramlar"
                android:textColor="#000000"
                android:textSize="20sp"/>
            <!--  kaydet butonu (uygulama içinde ama)  -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/kaydet_butonu"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />
                <ImageButton
                    android:id="@+id/btnKaydet"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_kaydet_button"
                    android:contentDescription="@string/kaydet_butonu"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bookmark_save"/>
            </LinearLayout>
        </RelativeLayout>
        <!--  açıklama notu  -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/a_a_da_sa_a_do_ru_alakal_di_er_kavramlar_s_ralan_r_recycler_view_ile"
            android:textColor="#000000"
            android:textSize="16sp"/>
        <!--  BAĞLANTILI KAVRAMLAR - YATAY RECYCLERVIEW  -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBaglantiliKavramlar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_baglantili_kavram"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>