<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Üst Başlık ve İçerik Sayacı -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kaydedilenler"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/daha_sonra_okumak_icin_kaydettigin_icerikler"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- İçerik Sayısı Badge -->
        <TextView
            android:id="@+id/txtItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_black_icon_box"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/x_icerik"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Arama Çubuğu -->
    <LinearLayout
        android:id="@+id/searchLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/headerLayout"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_kaydet_button"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="#94A3B8" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:hint="@string/kaydedilenlerde_ara"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Filtre Butonları (Tümü, Kavramlar, Metinler) -->
    <LinearLayout
        android:id="@+id/filterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchLayout"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_black_icon_box"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/tumu"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilterConcepts"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_kaydet_button"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/kavramlar"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilterTexts"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_kaydet_button"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/metinler"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Kaydedilen İçerikler Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSaved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/filterLayout"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/kaydedilen_sey_buton_iste"/>

</RelativeLayout>