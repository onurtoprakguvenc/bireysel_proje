<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="all">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Üst Bar: Başlık ve Aksiyon Simgeleri -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/containerTopActions"
                android:layout_centerVertical="true"
                android:text="Başlıksız Not"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/containerTopActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Geçici Not Kalan Süre Rozeti -->
                <TextView
                    android:id="@+id/tvCardEphemeralBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:backgroundTint="#FEE2E2"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:text="2 dk"
                    android:textColor="#DC2626"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Sabitleme İğnesi -->
                <ImageButton
                    android:id="@+id/btnPin"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sabitle"
                    android:padding="2dp"
                    android:src="@drawable/ic_pin"
                    app:tint="#94A3B8" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Kategori Rozeti -->
        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#F1F5F9"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="Kişisel"
            android:textColor="#475569"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Çizim Ön İzleme Alanı (Kilitliyken GONE yapılır) -->
        <FrameLayout
            android:id="@+id/layoutDrawingPreview"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#F8FAFC"
            android:padding="4dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgDrawingPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Çizim Ön İzlemesi" />
        </FrameLayout>

        <!-- Metin İçeriği Özeti (Kilitliyken 'Bu not kilitlidir' yazar) -->
        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Not içeriği..." />

        <!-- Kart Alt Barı: Tarih, Kilit ve Çöp Kutusu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvNoteDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="25 Ağu, 06:31"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <!-- Sağ Alt Buton Grubu (Kilit + Çöp Kutusu) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Kilit Butonu (Çöp kutusunun hemen solunda) -->
                <ImageButton
                    android:id="@+id/btnLockNote"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notu Kilitle"
                    android:padding="4dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#94A3B8" />

                <!-- 2. Silme Butonu -->
                <ImageButton
                    android:id="@+id/btnDeleteNote"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notu Sil"
                    android:padding="4dp"
                    android:src="@drawable/ic_trash"
                    app:tint="#CBD5E1" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>