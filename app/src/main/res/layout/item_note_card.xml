<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst Satır: Başlık ve İğne Butonu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnPin"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Başlıksız Not"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPin"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sabitle"
                android:padding="4dp"
                android:src="@drawable/ic_pin"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <!-- Kategori & Meta Rozetleri (Canvas Hap Tarzı) -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_inactive"
                android:backgroundTint="#F1F5F9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🏷️ Kişisel"
                android:textColor="#0284C7"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Metin Önizleme Alanı -->
        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:text="Not içeriği buraya gelecek ve iki satır halinde şık bir şekilde önizlenecek..."
            android:textColor="#475569"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/layoutDrawingPreview"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_inactive"
            android:backgroundTint="#FFFBEB"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgDrawingPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Çizim Önizlemesi" />
        </FrameLayout>

        <!-- Alt Satır: Tarih ve Silme Butonu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvNoteDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="23 Ağu, 09:15"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnDeleteNote"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sil"
                android:padding="5dp"
                android:src="@drawable/ic_trash"
                app:tint="#CBD5E1" />
        </RelativeLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>