<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Üst Başlık ve Kapatma Butonu Satırı -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/txtDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/gorus_duzeltme_bildir"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_close"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <!-- Açıklama Metni -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/bu_kavramla_ilgili_hatali_bir_bilgi_veya_gorusunu_asagiya_yazabilirsin"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Metin Giriş Alanı (EditText) -->
        <EditText
            android:id="@+id/etFeedbackText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_edittext_rounded"
            android:gravity="top|start"
            android:hint="@string/gorus_duzeltme_bildir"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Alt Butonlar Satırı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- İptal Butonu -->
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#F1F5F9"
                android:text="@string/iptal"
                android:textAllCaps="false"
                android:textColor="#475569"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <!-- Gönder Butonu -->
            <Button
                android:id="@+id/btnSendFeedback"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#F59E0B"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="6dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/gonder"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:drawableTint="#FFFFFF"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>