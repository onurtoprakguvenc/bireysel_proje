<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:backgroundTint="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp"
    android:elevation="16dp">

    <!-- Üst Başlık ve İkon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_purple"
            android:backgroundTint="#FEF3C7"
            android:padding="9dp"
            android:src="@drawable/ic_time"
            app:tint="#D97706" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gecici_not_suresi"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sure_bitiminde_not_geri_donusume_tasınır"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bilgilendirme ve Seçili Süre Kartı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_inactive"
        android:backgroundTint="#FFFBEB"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_trash"
            app:tint="#D97706" />

        <TextView
            android:id="@+id/txtSelectedExpiryInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sure_1_saat_sonra_silinecek"
            android:textColor="#92400E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Şablon Süre Butonları (1 Saat, 24 Saat, 3 Gün) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/btnQuick1Hour"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_black_pill"
            android:gravity="center"
            android:text="@string/_1_saat"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuick24Hours"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center"
            android:text="@string/_24_saat"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuick3Days"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center"
            android:text="@string/_3_gun"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Özel Tarih & Saat Seçim Butonu -->
    <TextView
        android:id="@+id/btnCustomDateTime"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_dashed_border"
        android:gravity="center"
        android:text="@string/ozel_tarih_ve_saat_sec"
        android:textColor="#0284C7"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Aksiyon Butonları (Vazgeç & Notu Başlat) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelExpiry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_inactive"
            android:gravity="center"
            android:text="@string/vazgec"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmExpiry"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:background="@drawable/bg_black_pill"
            android:gravity="center"
            android:text="@string/notu_olustur"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>