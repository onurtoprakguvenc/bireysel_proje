<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--  ANA İÇERİK  -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!--  ÜST BAR: hamburger menü + arama çubuğu + arama ikonu  -->
            <!-- yan yana dizilmeyi sağlama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!--  -->
                <ImageButton
                    android:id="@+id/btnAcDrawer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu"
                    android:padding="10dp"
                    android:src="@drawable/ic_menu_hamburger"
                    app:tint="#000000" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/ara"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/etArama"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/ara"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#000000"
                        android:textColorHint="#888888"
                        android:textSize="16sp" />

                </LinearLayout>
            </LinearLayout>

            <!--  ARAMA SONUÇ SAYISI (arama yapılınca görünür, aksi halde gone)  -->
            <TextView
                android:id="@+id/tvSonucSayisi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="@string/eslesme_bulundu"
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!--  BÖLÜM KARTLARI (Kavramlar / Kişisel Metinlerim / ileride yenileri)  -->
            <LinearLayout
                android:id="@+id/containerBolumKartlari"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!--  KART 1: KAVRAMLAR  -->
                <LinearLayout
                    android:id="@+id/cardKavramlar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/thumbnailKavramlar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="#000000" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/kavramlar"
                            android:textColor="#000000"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ogrendigin_ve_kesfettigin_kavramlar_kesfet"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>

                <!--  KART 2: KİŞİSEL METİNLERİM  -->
                <LinearLayout
                    android:id="@+id/cardKisiselMetinler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/thumbnailKisiselMetinler"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="#000000" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/kisisel_metinlerim"
                            android:textColor="#000000"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/kendi_yazdın_notlar_ve_denemeler"
                            android:textColor="#666666"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>

                <!--  İleride yeni bölümler eklenirse buraya, aynı desenle  -->
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--  SOLDAN AÇILAN NAVIGATION DRAWER  -->
    <include
        android:id="@+id/navDrawerContent"
        layout="@layout/nav_drawer_contents"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>