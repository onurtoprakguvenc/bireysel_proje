<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bildirim izni application etiketinin dışında olmalıdır -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hadi_bakalım">

        <activity
            android:name=".kavramlar_sayfa"
            android:exported="false" />

        <activity
            android:name=".model.GeriDonusumActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".model.CrashActivity"
            android:exported="false"
            android:process=":crash_process"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".model.bagis_sayfa"
            android:exported="false" />

        <activity
            android:name=".model.KisiselMetinlerimActivity"
            android:exported="false" />

        <activity
            android:name=".model.kaydet_ana_sayfa"
            android:exported="false" />

        <activity
            android:name=".model.SonIncelemeActivity"
            android:exported="false" />

        <activity
            android:name=".model.AyarlarActivity"
            android:exported="false" />

        <activity
            android:name=".kisisel_metin_okuma_sayfa"
            android:exported="false" />

        <activity
            android:name=".model.not_bagis_sayfa"
            android:exported="false" />

        <activity
            android:name=".model.not_alma_sayfa"
            android:exported="false" />

        <activity
            android:name=".noroplastite"
            android:exported="false" />

        <!-- YENİ ANA SAYFA (Açılış Ekranı) -->
        <activity
            android:name=".model.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ESKİ ANA SAYFA -->
        <activity
            android:name=".EskiMainActivity"
            android:exported="false" />

    </application>

</manifest>